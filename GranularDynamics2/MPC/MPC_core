class DynamicsModel(Protocol):
    """Predicts next state given current state and action."""
    def __init__(self, sim_kwargs: dict):
        super().__init__()
        self.env=MPCEnv(sim_kwargs=sim_kwargs,render=False)

    def rollout(
        self,
        init_state: torch.Tensor,
        action_seq: torch.Tensor,
    ) -> torch.Tensor:
        """
        Rolls out a batch of action sequences from initial states.

        Args:
            init_state: (B, *state_shape)
            action_seq: (B, T, *action_shape)
        Returns:
            states: (B, T+1, *state_shape)
        """
        for i in range(action_seq.shape[0]):
            self.env.reset_to_state(init_state)
            for t in range(action_seq.shape[1]):
                next_state, _, _, _ = self.env.step(action_seq[i,t].cpu().numpy())
                if t==0:
                    states = torch.tensor(next_state).unsqueeze(0).unsqueeze(0)
                else:
                    states = torch.cat((states,torch.tensor(next_state).unsqueeze(0).unsqueeze(0)),dim=1)
            if i==0:
                batch_states = states
            else:
                batch_states = torch.cat((batch_states,states),dim=0)
        return batch_states



