@dataclass
class MPCConfig:
    horizon: int
    batch_size: int
    max_iters: int
    elite_frac: float = 0.2
    loss_threshold: float = 1e-3
    device: str = "cpu"


# ============================
# Core MPC Class
# ============================

class MPCController:
    """
    Core MPC loop.

    This class knows *nothing* about:
    - granular physics
    - image vs vector state
    - simulator vs real robot

    It only orchestrates rollouts, losses, and action updates.
    """

    def __init__(
        self,
        dynamics: DynamicsModel,
        loss_fn: LossFunction,
        sampler: ActionSampler,
        config: MPCConfig,
    ):
        self.dynamics = dynamics
        self.loss_fn = loss_fn
        self.sampler = sampler
        self.cfg = config

    def optimize(
        self,
        init_state: torch.Tensor,
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        """
        Runs MPC optimization loop.

        Returns:
            best_action_seq: (T, *action_shape)
            best_loss: scalar
        """

        B = self.cfg.batch_size
        device = self.cfg.device

        actions = self.sampler.sample(B).to(device)
        init_state = init_state.to(device)

        best_loss = float("inf")
        best_action = None

        for it in range(self.cfg.max_iters):
            # Rollout
            states = self.dynamics.rollout(init_state.expand(B, *init_state.shape[1:]), actions)

            # Evaluate
            losses = self.loss_fn(states)

            # Track best
            min_loss, idx = losses.min(dim=0)
            if min_loss.item() < best_loss:
                best_loss = min_loss.item()
                best_action = actions[idx].detach().clone()

            # Termination
            if best_loss < self.cfg.loss_threshold:
                break

            # Rank trajectories
            elite_k = max(1, int(self.cfg.elite_frac * B))
            elite_idx = torch.topk(-losses, elite_k).indices

            elite_actions = actions[elite_idx]
            elite_losses = losses[elite_idx]

            # Reconstruct batch (sampler decides how)
            actions = self.sampler.refine(elite_actions, elite_losses)

        return best_action, torch.tensor(best_loss)




class RandomGaussianSampler:
    """CEM-style sampler stub."""

    def __init__(self, horizon, action_dim, sigma=0.3):
        self.horizon = horizon
        self.action_dim = action_dim
        self.sigma = sigma

    def sample(self, batch_size):
        return torch.randn(batch_size, self.horizon, self.action_dim) * self.sigma

    def refine(self, elite_actions, elite_losses):
        mean = elite_actions.mean(dim=0, keepdim=True)
        std = elite_actions.std(dim=0, keepdim=True) + 1e-6
        B = elite_actions.shape[0]
        return mean + std * torch.randn(B, *mean.shape[1:])


