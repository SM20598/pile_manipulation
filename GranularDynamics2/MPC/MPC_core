import torch.nn as nn

class MPCBasicLoss(nn.Module):
    """
    Differentiable batch loss for MPC trajectories.

    Expects states shaped (B, T+1, *state_shape) and returns (B,) losses.
    Combines a final-state L2 error to an optional goal with a per-step
    state-regularization term (mean L2 over timesteps). Fully differentiable.
    """

    def __init__(
        self,
        cfg,  # MPCConfig or similar; kept for API compatibility
        goal_state: Optional[torch.Tensor] = None,
        final_weight: float = 1.0,
        step_weight: float = 0.1,
    ):
        super().__init__()
        self.cfg = cfg
        self.final_weight = float(final_weight)
        self.step_weight = float(step_weight)

        if goal_state is not None:
            # register as buffer so it moves with the module/device
            self.register_buffer("goal_state", goal_state.clone())
        else:
            self.goal_state = None

    def forward(self, states: torch.Tensor) -> torch.Tensor:
        """
        Args:
            states: (B, T+1, *state_shape)
        Returns:
            losses: (B,)
        """
        # final-state error
        final = states[:, -1]  # (B, *s)
        if self.goal_state is not None:
            goal = self.goal_state.to(final.device)
            goal = goal.expand_as(final)
            final_err = torch.norm(final - goal, dim=tuple(range(1, final.ndim)))
        else:
            final_err = torch.norm(final, dim=tuple(range(1, final.ndim)))

        # per-step state regularization (exclude initial state at t=0)
        step_states = states[:, 1:]  # (B, T, *s)
        B, T = step_states.shape[:2]
        flat = step_states.reshape(B, T, -1)  # (B, T, S)
        step_norms = torch.norm(flat, dim=2)  # (B, T)
        step_err = step_norms.mean(dim=1)  # (B,)

        loss = self.final_weight * final_err + self.step_weight * step_err
        return loss


